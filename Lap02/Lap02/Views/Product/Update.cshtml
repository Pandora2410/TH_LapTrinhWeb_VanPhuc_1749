@model Lap02.Models.Product

@{
    ViewData["Title"] = "Update Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

</style>

<div class="update-page">
    <div class="update-container">

        <div class="update-header">
            <div>
                <h1 class="update-title">Update Product</h1>
                <p class="update-subtitle">Edit product information and change product image.</p>
            </div>

            <a asp-action="Index" class="back-link">
                ← Back to List
            </a>
        </div>

        <div class="update-card">
            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="update-layout">

                    <div class="image-panel">
                        <div class="image-title">Product Image</div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="current-image" />
                        }
                        else
                        {
                            <div class="no-image-box">
                                No image
                            </div>
                        }

                        <div class="upload-box">
                            <label class="upload-label">Change Image</label>
                            <input type="file" name="imageUrl" class="form-control" />
                            <p class="upload-note">Choose a new image if you want to replace the current one.</p>
                        </div>
                    </div>

                    <div class="form-panel">
                        <h4 class="form-section-title">Product Information</h4>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Id" class="control-label"></label>
                                    <input asp-for="Id" class="form-control" readonly />
                                    <span asp-validation-for="Id" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="CategoryId" class="control-label">Category</label>
                                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Name" class="control-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Price" class="control-label"></label>
                            <input asp-for="Price" class="form-control" placeholder="Enter product price" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="control-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="button-group">
                            <input type="submit" value="Save Changes" class="btn-save" />

                            <a asp-action="Index" class="btn-cancel">
                                Cancel
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}