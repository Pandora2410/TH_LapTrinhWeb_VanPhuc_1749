@using Microsoft.AspNetCore.Http
@model IEnumerable<Lap02.Models.Product>

@{
    ViewData["Title"] = "Product List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var username = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
    var isAdmin = role == "Admin";
}

<div class="product-page">

    <div class="page-header">
        <div>
            <h1 class="page-title">Product Management</h1>

            @if (!string.IsNullOrEmpty(username))
            {
                <p class="page-subtitle">
                    Welcome, <strong>@username</strong> - Role: <strong>@role</strong>
                </p>
            }
            else
            {
                <p class="page-subtitle">
                    You are viewing as Guest.
                </p>
            }
        </div>

        @if (isAdmin)
        {
            <a asp-action="Add" class="btn-create">
                + Create New
            </a>
        }
    </div>

    <div class="product-card">
        <table class="table custom-table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Id)
                    </th>

                    <th>
                        Image
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.Price)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>

                    <th>
                        Category
                    </th>
                    <th>
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>#@Html.DisplayFor(modelItem => item.Id)</strong>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="product-img" />
                                }
                                else
                                {
                                    <span class="no-image">No image</span>
                                }
                            </td>

                            <td>
                                <span class="product-name">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </span>
                            </td>

                            <td>
                                <span class="price-badge">
                                    @Html.DisplayFor(modelItem => item.Price)
                                </span>
                            </td>

                            <td>
                                <div class="description-text">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </div>
                            </td>

                            <td>
                                <span class="category-badge">
                                    Category @Html.DisplayFor(modelItem => item.CategoryId)
                                </span>
                            </td>
                            <td>
                                <div class="action-group">
                                    <a asp-action="Display" asp-route-id="@item.Id" class="btn-action btn-detail">
                                        Details
                                    </a>
                                </div>
                            </td>
                            @if (isAdmin)
                            {
                                <td>
                                    <div class="action-group">
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn-action btn-edit">
                                            Edit
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isAdmin ? 7 : 6)">
                            <div class="empty-box">
                                No products found.

                                @if (isAdmin)
                                {
                                    <span>Click <strong>Create New</strong> to add your first product.</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>