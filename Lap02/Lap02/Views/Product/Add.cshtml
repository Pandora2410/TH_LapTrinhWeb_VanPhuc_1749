@model Lap02.Models.Product

@{
    ViewData["Title"] = "Add Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

</style>

<div class="add-page">
    <div class="add-container">

        <div class="add-header">
            <div>
                <h1 class="add-title">Add Product</h1>
                <p class="add-subtitle">Create a new product with name, price, category and image.</p>
            </div>

            <a asp-action="Index" class="back-link">
                ← Back to List
            </a>
        </div>

        <div class="form-card">
            <h4 class="form-section-title">Product Information</h4>

            <form asp-action="Add" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Id" class="control-label"></label>
                            <input asp-for="Id" class="form-control" placeholder="Enter product ID" />
                            <span asp-validation-for="Id" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CategoryId" class="control-label">Category</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" placeholder="Enter product price" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="control-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ImageUrl" class="control-label">Product Image</label>

                    <div class="image-upload-box">
                        <input type="file" name="imageUrl" class="form-control" />
                        <p class="image-note">Choose an image file for this product.</p>
                    </div>
                </div>

                <div class="button-group">
                    <input type="submit" value="Create Product" class="btn-create" />

                    <a asp-action="Index" class="btn-cancel">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}