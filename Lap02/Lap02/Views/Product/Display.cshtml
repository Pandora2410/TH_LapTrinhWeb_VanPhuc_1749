@model Lap02.Models.Product

@{
    ViewData["Title"] = "Product Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

</style>

<div class="detail-page">
    <div class="detail-container">

        <div class="detail-header">
            <div>
                <h1 class="detail-title">Product Detail</h1>
                <p class="detail-subtitle">View full information of the selected product.</p>
            </div>

            <a asp-action="Index" class="back-link">
                ← Back to List
            </a>
        </div>

        <div class="detail-card">
            <div class="product-layout">

                <div class="image-box">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="product-image" />
                    }
                    else
                    {
                        <div class="no-image-box">
                            No image
                        </div>
                    }
                </div>

                <div class="info-box">
                    <h4 class="info-section-title">Product Information</h4>

                    <div class="info-row">
                        <div class="info-label">Product Name</div>
                        <div class="product-name">
                            @Html.DisplayFor(model => model.Name)
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Product ID</div>
                        <div class="info-value">
                            <span class="id-badge">
                                #@Html.DisplayFor(model => model.Id)
                            </span>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Price</div>
                        <div class="info-value">
                            <span class="price-badge">
                                @Html.DisplayFor(model => model.Price)
                            </span>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Category</div>
                        <div class="info-value">
                            <span class="category-badge">
                                Category @Html.DisplayFor(model => model.CategoryId)
                            </span>
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Description</div>
                        <div class="description-box">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Html.DisplayFor(model => model.Description)
                            }
                            else
                            {
                                <span>No description</span>
                            }
                        </div>
                    </div>

                    <div class="button-group">
                        <a asp-action="Index" class="btn-back">
                            Back to List
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>