@model Lap02.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-4 order-success-page">
    <div class="alert alert-success">
        <h4>Đặt hàng thành công!</h4>
        <p>Cảm ơn bạn đã mua hàng tại BookTown.</p>
    </div>

    <div class="card p-4 mb-4">
        <h4>Thông tin đơn hàng</h4>

        <p><strong>Mã đơn hàng:</strong> #@Model.Id</p>
        <p><strong>Người nhận:</strong> @Model.CustomerName</p>
        <p><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
        <p><strong>Địa chỉ:</strong> @Model.Address</p>
        <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
        <p><strong>Trạng thái:</strong> @Model.Status</p>
        <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>

        <h4 class="text-danger">
            Tổng tiền: @String.Format("{0:N0}đ", Model.TotalAmount)
        </h4>
    </div>

    <h4>Chi tiết sản phẩm</h4>

    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Ảnh</th>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 style="width: 60px; height: 80px; object-fit: cover; border-radius: 8px;" />
                        }
                    </td>

                    <td>@item.ProductName</td>

                    <td>@String.Format("{0:N0}đ", item.UnitPrice)</td>

                    <td>@item.Quantity</td>

                    <td>@String.Format("{0:N0}đ", item.TotalPrice)</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Product"
       asp-action="Index"
       class="btn btn-primary">
        Tiếp tục mua sách
    </a>
</div>