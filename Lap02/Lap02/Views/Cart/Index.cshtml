@model List<Lap02.Models.ShoppingCartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    decimal totalAmount = ViewBag.TotalAmount is decimal value ? value : 0m;
}

<div class="container mt-4 cart-page">
    <h2 class="mb-4">Giỏ hàng của bạn</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Giỏ hàng hiện đang trống.
        </div>

        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
            Tiếp tục mua sách
        </a>
    }
    else
    {
        <table class="table table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Giá</th>
                    <th style="width: 180px;">Số lượng</th>
                    <th>Thành tiền</th>
                    <th style="width: 120px;">Xóa</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     style="width: 70px; height: 90px; object-fit: cover; border-radius: 8px;" />
                            }
                            else
                            {
                                <span>Không có ảnh</span>
                            }
                        </td>

                        <td>@item.ProductName</td>

                        <td>@String.Format("{0:N0}đ", item.Price)</td>

                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <form asp-controller="Cart" asp-action="Decrease" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">-</button>
                                </form>

                                <span class="fw-bold">@item.Quantity</span>

                                <form asp-controller="Cart" asp-action="Increase" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">+</button>
                                </form>
                            </div>
                        </td>

                        <td class="fw-bold">
                            @String.Format("{0:N0}đ", item.Total)
                        </td>

                        <td>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center">
            <form asp-controller="Cart" asp-action="Clear" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    Xóa toàn bộ giỏ hàng
                </button>
            </form>

            <div class="text-end">
                <h4>
                    Tổng tiền:
                    <span class="text-danger">
                        @String.Format("{0:N0}đ", totalAmount)
                    </span>
                </h4>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Tiếp tục mua
                </a>

                <a asp-controller="Cart"
                   asp-action="Checkout"
                   class="btn btn-success">
                    Thanh toán
                </a>
            </div>
        </div>
    }
</div>