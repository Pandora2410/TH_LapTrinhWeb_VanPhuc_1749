@model Lap02.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <h2>Chi tiết sản phẩm</h2>

    <div class="card p-4">
        <div class="row">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="img-fluid rounded"
                         style="max-height: 350px; object-fit: cover;" />
                }
                else
                {
                    <div class="border p-5 text-center">
                        Không có ảnh
                    </div>
                }
            </div>

            <div class="col-md-8">
                <h3>@Model.Name</h3>

                <p>
                    <strong>Danh mục:</strong>
                    @(Model.Category != null ? Model.Category.Name : "Không có danh mục")
                </p>

                <p>
                    <strong>Giá:</strong>
                    @String.Format("{0:N0}đ", Model.Price)
                </p>

                <p>
                    <strong>Mô tả:</strong>
                    <br />
                    @Model.Description
                </p>

                <a asp-area="Admin"
                   asp-controller="Admin"
                   asp-action="Update"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Sửa
                </a>

                <a asp-area="Admin"
                   asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
