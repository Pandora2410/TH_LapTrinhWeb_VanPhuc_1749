@model IEnumerable<Lap02.Models.Product>

@{
    ViewData["Title"] = "Admin - Quản lý sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Quản lý sản phẩm</h2>
            <p class="text-muted mb-0">Khu vực Admin dùng để thêm, sửa, xóa và xem chi tiết sản phẩm.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Admin"
           asp-action="Add"
           class="btn btn-primary">
            + Thêm sản phẩm
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th style="width: 260px;">Chức năng</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name"
                                     style="width: 70px; height: 90px; object-fit: cover; border-radius: 8px;" />
                            }
                            else
                            {
                                <span>Không có ảnh</span>
                            }
                        </td>

                        <td>@item.Name</td>

                        <td>
                            @(item.Category != null ? item.Category.Name : "Không có danh mục")
                        </td>

                        <td>
                            @String.Format("{0:N0}đ", item.Price)
                        </td>

                        <td>
                            <a asp-area="Admin"
                               asp-controller="Admin"
                               asp-action="Display"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                Chi tiết
                            </a>

                            <a asp-area="Admin"
                               asp-controller="Admin"
                               asp-action="Update"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Sửa
                            </a>

                            <a asp-area="Admin"
                               asp-controller="Admin"
                               asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">
                        Chưa có sản phẩm nào.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
